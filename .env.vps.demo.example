# Copy to .env.vps.demo on the VPS, then replace placeholder secrets.

# API publish settings for demo backend
# Use 127.0.0.1 and reverse proxy via Nginx for public access.
API_BIND=127.0.0.1
API_PORT=8081

# PostgreSQL container credentials (demo DB)
DB_USER=rygell
DB_PASSWORD=change_me_demo_db
DB_NAME=rygell_dashboard_demo

# Security-critical backend settings (demo secrets should differ from production)
JWT_SECRET=change_me_demo_to_a_strong_random_secret_at_least_32_chars
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_demo_admin
ADMIN_SYNC_PASSWORD=false

# Frontend origin(s) allowed to call cookie-authenticated API
# Use exact origins, comma-separated. Example:
# FRONTEND_ORIGINS=https://demo-app.example.com,https://staging-app.example.com
FRONTEND_ORIGINS=https://your-demo-frontend-domain.example

# Cookie settings for HTTPS cross-site requests
COOKIE_NAME=auth_token
COOKIE_DOMAIN=
COOKIE_SAMESITE=None
COOKIE_SECURE=true

# Runtime hardening
GIN_MODE=release
TRUSTED_PROXIES=127.0.0.1/32
DB_LOG_LEVEL=warn
MAX_BODY_BYTES=10485760
IMPORT_MAX_BYTES=57671680
IMPORT_JSON_BYTES=20971520
IMPORT_KEEP_FILES=false
